generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
}

model User {
  id           Int      @id @default(autoincrement())
  username     String   @unique @db.VarChar(100)
  passwordHash String   @db.VarChar(255)
  role         UserRole @default(USER)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sessions Session[]
  assignedFeedbacks Feedback[] @relation("FeedbackAssignee")
  feedbackAuditEvents FeedbackAuditEvent[] @relation("FeedbackActor")

  @@map("users")
}

model Session {
  id        String   @id @db.VarChar(64)
  userId    Int
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model Vehicle {
  id        Int      @id @default(autoincrement())
  name      String   @unique @db.VarChar(255)
  type      String?  @db.VarChar(100)
  routeId   Int?
  latitude  Decimal? @db.Decimal(10, 8)
  longitude Decimal? @db.Decimal(11, 8)
  lastSeenAt DateTime?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  route Route? @relation(fields: [routeId], references: [id], onDelete: SetNull)
  trips Trip[]
  gpsTracks GpsTrack[]
  trackingSources TrackingSource[]
  feedbacks Feedback[]

  @@index([routeId])
  @@map("vehicles")
}

model Route {
  id        Int      @id @default(autoincrement())
  name      String   @unique @db.VarChar(255)
  color     String?  @db.VarChar(20)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  vehicles    Vehicle[]
  routeStops  RouteStop[]
  trips       Trip[]

  @@map("routes")
}

model Stop {
  id        Int      @id @default(autoincrement())
  nameTh    String   @db.VarChar(255)
  nameEn    String?  @db.VarChar(255)
  latitude  Decimal  @db.Decimal(10, 8)
  longitude Decimal  @db.Decimal(11, 8)
  imageUrl  String?  @db.VarChar(500)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  routeStops RouteStop[]

  @@index([isActive])
  @@map("stops")
}

model RouteStop {
  id        Int      @id @default(autoincrement())
  routeId   Int
  stopId    Int
  stopOrder Int
  createdAt DateTime @default(now())

  route Route @relation(fields: [routeId], references: [id], onDelete: Cascade)
  stop  Stop  @relation(fields: [stopId], references: [id], onDelete: Cascade)

  @@unique([routeId, stopId])
  @@unique([routeId, stopOrder])
  @@index([stopId])
  @@map("route_stops")
}

model Trip {
  id        Int      @id @default(autoincrement())
  vehicleId Int
  routeId   Int
  startedAt DateTime?
  endedAt   DateTime?
  status    String   @default("PENDING") @db.VarChar(50)
  createdAt DateTime @default(now())

  vehicle   Vehicle    @relation(fields: [vehicleId], references: [id])
  route     Route      @relation(fields: [routeId], references: [id])
  gpsTracks GpsTrack[]

  @@index([vehicleId])
  @@index([routeId])
  @@map("trips")
}

model GpsTrack {
  id         Int      @id @default(autoincrement())
  vehicleId  Int
  tripId     Int?
  latitude   Decimal  @db.Decimal(10, 8)
  longitude  Decimal  @db.Decimal(11, 8)
  speed      Decimal? @db.Decimal(8, 2)
  heading    Decimal? @db.Decimal(6, 2)
  recordedAt DateTime @default(now())

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  trip    Trip?   @relation(fields: [tripId], references: [id], onDelete: SetNull)

  @@index([vehicleId])
  @@index([tripId])
  @@index([recordedAt])
  @@map("gps_tracks")
}

model TrackingSource {
  id         Int      @id @default(autoincrement())
  vehicleId  Int
  type       String   @db.VarChar(100)
  identifier String   @unique @db.VarChar(255)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId])
  @@map("tracking_sources")
}

model Feedback {
  id           Int      @id @default(autoincrement())
  type         String   @db.VarChar(100)
  vehicleId    Int?
  message      String
  status       String   @default("OPEN") @db.VarChar(50)
  assignedToId Int?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  vehicle      Vehicle?               @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  assignedTo   User?                  @relation("FeedbackAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  auditEvents  FeedbackAuditEvent[]

  @@index([vehicleId])
  @@index([assignedToId])
  @@map("feedbacks")
}

model FeedbackAuditEvent {
  id         Int      @id @default(autoincrement())
  feedbackId Int
  actorId    Int?
  eventType  String   @db.VarChar(100)
  oldStatus  String?  @db.VarChar(50)
  newStatus  String?  @db.VarChar(50)
  note       String?
  createdAt  DateTime @default(now())

  feedback Feedback @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
  actor    User?    @relation("FeedbackActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([feedbackId])
  @@index([actorId])
  @@map("feedback_audit_events")
}
